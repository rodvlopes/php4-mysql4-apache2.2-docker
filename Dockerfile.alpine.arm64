FROM arm64v8/alpine:3.5 as build
RUN apk add --no-cache build-base ncurses-dev zlib-dev wget flex perl libc6-compat m4 patch

WORKDIR /tmp

# Build Apache 2.2
ADD httpd-2.2.34.tar.bz2 .
RUN cd httpd-2.2.34 \
  &&./configure --prefix=/usr/local/apache2 --enable-mods-shared=all --enable-deflate --enable-proxy --enable-proxy-balancer --enable-proxy-http \
  && make \
  && make install

# PHP 4's buildconf (needed to add ext/sqlite) only produces a working configure with autoconf 2.13
ADD autoconf-2.13.tar.gz .
RUN cd autoconf-2.13 && ./configure --program-suffix=-2.13 && make && make install

# Build SQLite 2.8 CLI (same file format as the PHP extension)
ADD sqlite-2.8.17.tar.gz .
RUN mkdir sqlite-build && cd sqlite-build \
  && ../sqlite-2.8.17/configure --prefix=/usr/local/sqlite2 --build=aarch64-unknown-linux-gnu --disable-tcl --disable-shared \
  && make && make install

# Build PHP 4
ADD php-4.4.9.tar.bz2 .
ADD php.ini /usr/local/apache2/php.ini

# PECL SQLite 1.0.3 (bundles libsqlite 2.8.14), built statically into PHP
ADD SQLite-1.0.3.tgz .
COPY patches/pecl-sqlite-1.0.3-lp64.patch .
# touch: buildconf only regenerates configure if a config.m4 is newer, and an outdated parse.c would require yacc
RUN cp -rp SQLite-1.0.3 php-4.4.9/ext/sqlite \
  && patch -p1 -d php-4.4.9/ext/sqlite < pecl-sqlite-1.0.3-lp64.patch \
  && touch php-4.4.9/ext/sqlite/config.m4 php-4.4.9/ext/sqlite/libsqlite/src/parse.c php-4.4.9/ext/sqlite/libsqlite/src/parse.h

WORKDIR /tmp/php-4.4.9
RUN PHP_AUTOCONF=autoconf-2.13 PHP_AUTOHEADER=autoheader-2.13 ./buildconf --force && grep -q with-sqlite configure
RUN ./configure --with-apxs2=/usr/local/apache2/bin/apxs --with-mysql --with-sqlite --enable-force-cgi-redirect --disable-cgi --with-zlib --with-config-file-path=/usr/local/apache2 --host=aarch64-unknown-linux-gnu
RUN sed -i "/CFLAGS_CLEAN =/c\CFLAGS_CLEAN = -g -O2 -fcommon" Makefile
RUN sed -i "/CPP =/c\CPP = gcc -E -fcommon" Makefile
# libtool's file_magic check is broken on aarch64/musl: it rejects valid shared
# libs (libz, musl libc) and falls back to a static libphp4.a, so no libphp4.so
# is produced and apxs fails. Force pass_all so libtool trusts the linker.
RUN sed -i 's/^deplibs_check_method=.*/deplibs_check_method="pass_all"/' libtool
RUN make && make install

WORKDIR /tmp

# Setup PHP to Run on Apache
RUN echo 'AddType application/x-httpd-php php' >> /usr/local/apache2/conf/httpd.conf \
  && sed -i 's/DirectoryIndex index.html/DirectoryIndex index.php index.html/' /usr/local/apache2/conf/httpd.conf \
  && printf '<FilesMatch "\\.(db|sqlite|sqlite2)$">\n    Order allow,deny\n    Deny from all\n</FilesMatch>\n' >> /usr/local/apache2/conf/httpd.conf

# Build Mysql 4
ADD mysql-4.1.22.tar.bz2 .

RUN echo '/* Linuxthreads */' >> /usr/include/pthread.h
WORKDIR /tmp/mysql-4.1.22
RUN ./configure --prefix=/usr/local/mysql --build=aarch64-unknown-linux-gnu CXXFLAGS="-std=gnu++98 -fpermissive"
RUN sed -i "/HAVE_GETHOSTBYADDR_R/d" config.h
RUN sed -i "/HAVE_GETHOSTBYNAME_R/d" config.h
RUN make && make install

WORKDIR /tmp

# Linuxtrheads hack explained: https://bugs.mysql.com/bug.php?id=19785
# gnu++98 (error: narrowing conversion):  https://bugs.mysql.com/bug.php?id=19785
# libc6-compat solves the problem of missing libm.so on aarch64

FROM arm64v8/alpine

RUN apk add --no-cache libstdc++ tzdata

# Setup Mysql to Run
ADD my.cnf /usr/local/mysql/my.cnf
RUN addgroup -S mysql && adduser -S mysql -G mysql \
  && mkdir /usr/local/mysql/var \
  && chown -R root /usr/local/mysql && chown -R mysql /usr/local/mysql/var && chgrp -R mysql /usr/local/mysql \
  && mkdir -p /usr/local/sqlite/var

COPY --from=build /usr/local/apache2 /usr/local/apache2
COPY --from=build /usr/local/mysql /usr/local/mysql
COPY --from=build /usr/local/sqlite2/bin/sqlite /usr/local/bin/sqlite

ENV PATH="${PATH}:/usr/local/apache2/bin/:/usr/local/mysql/bin/"
VOLUME /usr/local/mysql/var /usr/local/sqlite/var /usr/local/apache2/htdocs/
EXPOSE 80 
CMD apachectl start \
    && chown daemon -R /usr/local/apache2/htdocs/ \
    && chown daemon -R /usr/local/sqlite/var/ \
    && chown mysql -R /usr/local/mysql/var/ \
    && mysqld_safe --defaults-file=/usr/local/mysql/my.cnf 
